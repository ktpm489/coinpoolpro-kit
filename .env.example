# Copy thành .env (không commit). Mỗi dòng dạng KEY=VALUE, không để chú thích ở cuối dòng.
BASE_URL=https://cpv2-api.bacoor-test001.xyz

# Đăng nhập: bỏ dấu # ở MỘT cách
# AUTH_HEADER=Bearer eyJ...
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# TEST_PRIVATE_KEY=0x...

# Tiền tố token khi đăng nhập tự động (để rỗng nếu API dùng token trần)
AUTH_SCHEME="Bearer "

# Chỉ cho tests/test_admin_access.py: token của user THƯỜNG (hoặc dùng TEST_PRIVATE_KEY của ví không phải admin)
# USER_AUTH_HEADER=Bearer eyJ...

# Chỉ bật trên môi trường test, sau khi hỏi dev: chạy cả test có thể đổi dữ liệu
# ALLOW_DESTRUCTIVE=1
